# Nunca deixa o navegador (ou cache intermediario do host) guardar uma versao
# antiga do painel apos um novo deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
